{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PlotMaster",
  "version": "0.1.0",
  "identifier": "com.plotmaster.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PlotMaster",
        "width": 480,
        "height": 580,
        "resizable": true,
        "fullscreen": false,
        "tabbingIdentifier": "plotmaster"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
